# Supabase public credentials (optional only for local demo mode)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Required for every environment where admin API routes are enabled.
# Generate a random secret with at least 32 characters; never commit the real value.
ADMIN_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional additional admin email restriction. Set this in deployment secrets, not in source control.
ADMIN_EMAIL=

# Optional AI provider keys (keep server-side; never use NEXT_PUBLIC_ prefixes)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
